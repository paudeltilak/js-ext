{
  "manifest_version": 3,
  "name": "Script Shelf",
  "version": "0.5.0",
  "description": "Open your script palette with Option+Z, with Sentence Color One always ready on webpages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scripts/sentence-color-1.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Script Shelf"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      }
    }
  }
}
